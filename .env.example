# CryptoBit Exchange environment. Copy to .env.production (or .env for local runs) and fill in.
# Never commit a filled-in copy. The server validates everything at start and refuses to run on a bad value.

# ---- Mode ----
# sandbox: simulated providers, seed data and sandbox APIs. Never expose a sandbox instance publicly without basic auth.
# production: real provider adapters; any provider without credentials reports NOT_CONFIGURED and its actions are refused.
APP_MODE=production
NODE_ENV=production

# ---- Reverse proxy (compose.yaml / deploy/Caddyfile) ----
# DNS: A record for PUBLIC_DOMAIN and A record for CRM_DOMAIN → VPS IP.
PUBLIC_DOMAIN=YOUR_DOMAIN
CRM_DOMAIN=crm.YOUR_DOMAIN
# Legacy alias accepted by compose if PUBLIC_DOMAIN is unset:
# ARCVALE_DOMAIN=YOUR_DOMAIN
ACME_EMAIL=ops@YOUR_DOMAIN

# ---- Server origins (must match the browser URLs; no trailing slash) ----
PUBLIC_ORIGIN=https://YOUR_DOMAIN
CRM_ORIGIN=https://crm.YOUR_DOMAIN
# PORT=8787
# HOST=0.0.0.0
# Behind Caddy: client IPs come from X-Forwarded-For (compose.yaml sets this).
# TRUST_PROXY=true
# Defaults to ./data/arcvale-<APP_MODE>.db — keep on a persistent volume in production.
# DATABASE_PATH=/app/data/arcvale-production.db
LOG_LEVEL=info
# SESSION_TTL_HOURS=12
# Staff must enrol an authenticator app. Defaults to on in production.
# REQUIRE_STAFF_MFA=true

# ---- Secrets (generate fresh values; required in production) ----
# openssl rand -hex 32
SESSION_SECRET=
# openssl rand -base64 32   (encrypts payout details and MFA secrets at rest; losing it makes them unreadable)
DATA_ENCRYPTION_KEY=

# ---- Policy placeholders (OWNER/COUNSEL INPUT REQUIRED) ----
# Orders at or above this USD value always go to compliance review.
MANUAL_REVIEW_THRESHOLD_USD=10000

# ---- Exchange rates (CoinGecko by default) ----
# Default: CoinGecko for BTC, ETH, USDT, USDC, XRP, SOL and BNB (server side only; needs outbound HTTPS to
# api.coingecko.com, or pro-api.coingecko.com on the pro plan). There is no fallback to fabricated
# prices — if CoinGecko is unreachable or stale, quotes fail and the site shows "Rate unavailable".
# In sandbox mode deposit/payout providers stay simulated; only the price feed is live.
RATES_SOURCE=coingecko
# Optional. A free "Demo" key from https://www.coingecko.com/en/api raises the rate limit. Keep it out of git.
# COINGECKO_API_KEY=
# demo (api.coingecko.com, default) or pro (pro-api.coingecko.com, key required)
# COINGECKO_API_PLAN=demo
# One request covers all assets; it is repeated at most once per this many seconds (10-55).
COINGECKO_CACHE_SECONDS=30
# Offline/tests only: RATES_SOURCE=default uses the sandbox schedule (or RATES_PROVIDER_* below).
# Do not set RATES_PROVIDER_* together with RATES_SOURCE=coingecko.

# ---- Providers (production). Leave a block empty and that provider reports NOT_CONFIGURED. ----
# URLs must be https. Webhook secrets must be at least 32 characters. See docs/providers.md.
# Leave empty when using CoinGecko for rates (default).
RATES_PROVIDER_URL=
RATES_PROVIDER_API_KEY=

CUSTODY_PROVIDER_URL=
CUSTODY_PROVIDER_API_KEY=
CUSTODY_PROVIDER_WEBHOOK_SECRET=

KYC_PROVIDER_URL=
KYC_PROVIDER_API_KEY=
KYC_PROVIDER_WEBHOOK_SECRET=

SCREENING_PROVIDER_URL=
SCREENING_PROVIDER_API_KEY=

BANK_PAYOUT_PROVIDER_URL=
BANK_PAYOUT_PROVIDER_API_KEY=
BANK_PAYOUT_PROVIDER_WEBHOOK_SECRET=

CARD_PAYOUT_PROVIDER_URL=
CARD_PAYOUT_PROVIDER_API_KEY=
CARD_PAYOUT_PROVIDER_WEBHOOK_SECRET=

CASH_PROVIDER_URL=
CASH_PROVIDER_API_KEY=
CASH_PROVIDER_WEBHOOK_SECRET=

EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# ---- First staff account (CLI only; never a public endpoint) ----
# After first start:
#   ARCVALE_NEW_PASSWORD='…' docker compose --env-file .env.production exec -T app \
#     node --disable-warning=ExperimentalWarning dist-server/cli.js create-user \
#     --email you@YOUR_DOMAIN --role owner --name "Your Name"
# Re-running with the same email and role is a no-op (does not reset the password).

# ---- Sandbox only (rejected when APP_MODE=production) ----
# Local dual-host smoke (optional): PUBLIC_ORIGIN=http://localhost:43127 CRM_ORIGIN=http://127.0.0.1:43127
# SANDBOX_RATES=BTC=68420.15,ETH=3520.40,USDT=1.0001,USDC=0.9999
# SANDBOX_CONFIRMATIONS=bitcoin=4,ethereum=21
# SANDBOX_WEBHOOK_SECRET=
# Return sign-in and reset codes in API responses (no inbox needed). Default on in sandbox.
# SANDBOX_EXPOSE_CODES=true
# Demo autopilot: after a customer submits a transaction hash (sell) or the ID for a cash handover (buy),
# the sandbox simulators advance the order one step every N ms. 0 turns it off.
# SANDBOX_AUTOPILOT_STEP_MS=0
