# HTTPS reverse proxy for CryptoBit Exchange.
# Two hostnames share one internal app container (API + SPA + SQLite).
# Placeholders come from compose / .env.production — do not hardcode a real domain here.
{
	email {$ACME_EMAIL}
}

# Shared reverse-proxy snippet (imported by both host blocks via identical config).
# Customer site: https://YOUR_DOMAIN
{$PUBLIC_DOMAIN} {
	encode zstd gzip

	# KYC / receipt uploads allow up to ~6 MB; leave headroom for multipart overhead.
	request_body {
		max_size 8MB
	}

	# Optional: keep a sandbox/staging instance private. Generate a hash with
	#   docker compose exec caddy caddy hash-password
	# then uncomment:
	# basic_auth {
	# 	reviewer <hash>
	# }

	reverse_proxy app:8787 {
		# Server-sent events (/api/events) must stream without buffering.
		flush_interval -1
		header_up Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		health_uri /api/health
		health_interval 30s
	}

	header {
		# Do not set includeSubDomains until every hostname (including CRM) is confirmed on HTTPS.
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	log {
		output stdout
		format json
	}
}

# CRM: https://crm.YOUR_DOMAIN — same backend, separate browser origin and cookies.
{$CRM_DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 8MB
	}

	reverse_proxy app:8787 {
		flush_interval -1
		header_up Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		health_uri /api/health
		health_interval 30s
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	log {
		output stdout
		format json
	}
}
