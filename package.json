{
  "name": "exchange",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Arcvale: US-focused crypto-to-USD exchange. Sandbox mode is fully simulated for internal testing; production providers report NOT_CONFIGURED until credentials are supplied. Money movement is provider-gated.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build && vite build -c vite.server.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa:visual": "node .claude/skills/visual-qa/scripts/visual-qa.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"scripts/**/*.mjs\" \".claude/skills/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"scripts/**/*.mjs\" \".claude/skills/**/*.mjs\"",
    "dev:web": "vite",
    "start": "node --disable-warning=ExperimentalWarning dist-server/main.js",
    "start:local-prod": "./deploy/run-local-production.sh",
    "server:build": "vite build -c vite.server.config.ts",
    "server:cli": "node --disable-warning=ExperimentalWarning dist-server/cli.js",
    "server:seed": "pnpm server:build && pnpm server:cli seed",
    "server:scenarios": "pnpm server:build && pnpm server:cli scenarios",
    "test:server": "vitest run --project server"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/montserrat": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@gsap/react": "2.1.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "gsap": "3.15.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.56.0",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.8.1",
    "shadcn": "4.21.4",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
